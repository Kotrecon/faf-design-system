{
  "name": "@faf/z-index",
  "version": "0.0.1",
  "description": "Faf Design System — Z-index tokens, stacking context patterns, and accessibility integration",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/tokens.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "style": "./dist/tokens.css"
    },
    "./styles": {
      "style": "./dist/tokens.css"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "generate:tokens": "tsx ../../scripts/generate-zindex-tokens.mjs",
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite",
    "dev:viewer": "vite --config vite.viewer.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "pnpm run test && pnpm run test:e2e",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@faf/foundations": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "design-system",
    "faf",
    "z-index",
    "stacking-context",
    "web-components"
  ],
  "license": "MIT"
}
